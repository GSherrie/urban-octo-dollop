# SherPay — Next.js + Supabase + Resend
#
# Required environment variables for local development and Vercel.
# Copy this file to .env.local and fill in the values.
#
# Do not commit real secrets to source control.
# On Vercel, add these as Environment Variables in the project settings.

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# Public project URL used by the browser client and auth flows.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Anon key for browser clients. Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Optional: server-side service-role key.
# Use this ONLY in trusted server code, never in the browser.
# servant-role key can bypass RLS, so keep it server-side only.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ---------------------------------------------------------------------------
# Resend
# ---------------------------------------------------------------------------
# Resend API key. Used by Supabase edge functions and/or the Next.js app
# for verification emails, password resets, and app notifications.
RESEND_API_KEY=re_...

# Verified sender address in Resend. Must be a domain you have verified.
RESEND_FROM=no-reply@sherpay.app

# If you use a verified custom domain, set it here for nicer "From" headers.
RESEND_FROM_NAME=SherPay

# ---------------------------------------------------------------------------
# Optional app settings
# ---------------------------------------------------------------------------
# App front-end origin used in email links and redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Base URL used for server-side emails/notifications.
SITE_URL=http://localhost:3000
